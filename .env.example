# Copie este arquivo para .env.local para sobrescrever valores localmente.
# Nenhum destes valores é sensível — o Pixel do Meta fica visível no HTML de
# qualquer página do site, então isso é só para facilitar trocar o ID sem
# editar código (ex.: usar um pixel de teste em ambiente de dev).
NEXT_PUBLIC_META_PIXEL_ID=1747237356474748

# Banco de Leads (BI). Estes SÃO sensíveis: nunca versione o token.
# Lidos só no servidor (rota /api/lead-webhook). Em produção ficam no painel
# da GoDaddy. Sem as duas variáveis, o lead não é enviado ao BI (o WhatsApp
# continua funcionando) e o log mostra qual está ausente.
LEAD_WEBHOOK_URL=https://api-bi.bmztech.com.br/api/webhooks/leads/form
LEAD_WEBHOOK_TOKEN=
